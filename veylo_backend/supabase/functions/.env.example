# Edge Function secrets — copy to .env in this folder (gitignored).
# Push to Supabase: cd veylo_backend && supabase secrets set --env-file supabase/functions/.env
# Do NOT put EXPO_PUBLIC_* here — those belong in the repo-root .env for the Expo app.

OPENAI_API_KEY=

# Google Vertex AI — virtual try-on + Imagen avatar generation
GCP_PROJECT_ID=
GCP_LOCATION=us-central1
GCP_SA_CLIENT_EMAIL=
GCP_SA_PRIVATE_KEY=

OPENWEATHER_API_KEY=

# Daily spend / op caps (optional overrides; defaults in budget.ts)
DAILY_SPEND_CAP_USD=10
# DAILY_USER_TRYON_CAP=20
# DAILY_USER_AVATAR_CAP=5
# DAILY_USER_TAG_CAP=60
# DAILY_USER_EMBEDDING_CAP=100

# Deprecated — avatars use Gemini image via generate-avatar
READY_PLAYER_ME_API_KEY=

# Cron-triggered functions (digest-weekly, embeddings-backfill): header x-cron-secret
CRON_SECRET=

# Optional
SENTRY_EDGE_DSN=
EXPO_ACCESS_TOKEN=
