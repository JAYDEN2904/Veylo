# Copy this file: cp .env.example .env — then fill in all values.
# The real .env is gitignored; never commit it.
# Expo loads EXPO_PUBLIC_* at build time.
#
# Get API keys
# - OpenAI: https://platform.openai.com → API keys → Create new secret key
# - OpenWeather: https://openweathermap.org/api — Sign Up → API keys
# - Supabase: Dashboard → Project Settings → API → Project URL + anon public key

# -------------------------------------------------------------------
# Frontend (safe to ship in the bundle)
# -------------------------------------------------------------------

# Supabase — client-safe anon key only; never commit service role
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# OpenWeatherMap — optional; app falls back to mock if unset
EXPO_PUBLIC_OPENWEATHER_API_KEY=

# Observability (optional)
EXPO_PUBLIC_SENTRY_DSN=

# -------------------------------------------------------------------
# Edge Function secrets — NOT bundled with the Expo app
# Copy veylo_backend/supabase/functions/.env.example → .env in that folder,
# then push: cd veylo_backend && supabase secrets set --env-file supabase/functions/.env
# Supabase injects SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY automatically.
# -------------------------------------------------------------------
# (See veylo_backend/supabase/functions/.env.example for edge-only variables.)
