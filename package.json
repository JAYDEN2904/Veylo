{
  "name": "veylo",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "./expo-start.sh",
    "start:tunnel": "./expo-start.sh --tunnel",
    "android": "expo run:android",
    "android:reverse": "adb reverse tcp:8081 tcp:8081 && adb reverse tcp:8082 tcp:8082 && adb reverse tcp:19000 tcp:19000 && adb reverse tcp:19001 tcp:19001",
    "ios": "./ios-run.sh",
    "web": "./expo-start.sh --web",
    "ts:check": "tsc",
    "test": "jest",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"App.tsx\" --max-warnings 2000",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"App.tsx\" \"*.{mjs,js,cjs,json,md}\"",
    "backend:login": "cd veylo_backend && npx --yes supabase login",
    "backend:link": "cd veylo_backend && npx --yes supabase link --project-ref igeyjmcfklymyeaahmtw",
    "backend:push": "cd veylo_backend && npx --yes supabase db push",
    "backend:fns:deploy": "cd veylo_backend && npx --yes supabase functions deploy",
    "backend:types": "cd veylo_backend && npx --yes supabase gen types typescript --project-id igeyjmcfklymyeaahmtw --schema public > ../src/types/database.types.ts",
    "backend:smoke": "bash veylo_backend/scripts/smoke.sh",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings 2000",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@expo/vector-icons": "^14.0.0",
    "@react-native-async-storage/async-storage": "1.21.0",
    "@react-native-community/datetimepicker": "7.7.0",
    "@react-native-community/netinfo": "11.1.0",
    "@react-navigation/bottom-tabs": "^6.5.8",
    "@react-navigation/native": "^6.1.7",
    "@react-navigation/stack": "^6.3.17",
    "@supabase/supabase-js": "^2.104.0",
    "@tanstack/react-query": "^5.99.2",
    "date-fns": "^2.30.0",
    "expo": "~50.0.0",
    "expo-apple-authentication": "~6.3.0",
    "expo-application": "~5.8.4",
    "expo-auth-session": "~5.4.0",
    "expo-blur": "~12.9.2",
    "expo-camera": "~14.1.3",
    "expo-constants": "~15.4.6",
    "expo-crypto": "~12.8.1",
    "expo-dev-client": "~3.3.12",
    "expo-device": "~5.9.4",
    "expo-file-system": "~16.0.9",
    "expo-font": "~11.10.3",
    "expo-haptics": "~12.8.1",
    "expo-image": "~1.10.6",
    "expo-image-manipulator": "~11.8.0",
    "expo-image-picker": "~14.7.1",
    "expo-linear-gradient": "~12.7.2",
    "expo-localization": "~14.8.4",
    "expo-location": "~16.5.5",
    "expo-media-library": "~15.9.2",
    "expo-notifications": "~0.27.8",
    "expo-secure-store": "~12.8.1",
    "expo-splash-screen": "~0.26.5",
    "expo-status-bar": "~1.11.1",
    "expo-web-browser": "~12.8.2",
    "nativewind": "^2.0.11",
    "react": "18.2.0",
    "react-error-boundary": "^6.1.1",
    "react-native": "0.73.6",
    "react-native-gesture-handler": "~2.14.0",
    "react-native-reanimated": "~3.6.2",
    "react-native-safe-area-context": "4.8.2",
    "react-native-screens": "~3.29.0",
    "sentry-expo": "~7.2.0",
    "tailwind-merge": "^1.14.0",
    "tailwindcss": "3.3.2",
    "zustand": "^4.4.1"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/plugin-transform-class-properties": "^7.28.6",
    "@babel/plugin-transform-private-methods": "^7.28.6",
    "@babel/plugin-transform-private-property-in-object": "^7.28.6",
    "@eslint/js": "^9.14.0",
    "@types/jest": "30.0.0",
    "@types/react": "~18.2.45",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "husky": "^9.1.7",
    "jest": "^29.2.1",
    "lint-staged": "^15.5.2",
    "prettier": "^3.8.3",
    "ts-jest": "29.4.9",
    "typescript": "^5.1.3",
    "typescript-eslint": "^8.58.2"
  },
  "private": true
}
